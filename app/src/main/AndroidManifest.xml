<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fetching feeds and images, and knowing whether there is a network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      No POST_NOTIFICATIONS.

      A reader that notifies you about new stories is a reader that needs push,
      and push on Android means Firebase Cloud Messaging, which means Google
      Play services — the dependency this whole suite exists to avoid. Dispatch
      polls on a schedule the reader sets, and says nothing until it is opened.
      Tombot reached the same conclusion for the same reason.

      No location, no camera, no media access: it is a reader.
    -->

    <!--
      WorkManager brings its own manifest entries. RECEIVE_BOOT_COMPLETED is
      kept — it is how a periodic refresh survives a reboot — but the foreground
      service is removed:

        * this app never calls setForeground() and never enqueues expedited
          work, so SystemForegroundService is dead weight;
        * leaving it in would put FOREGROUND_SERVICE and
          FOREGROUND_SERVICE_DATA_SYNC in the installed app's permission list,
          which would be untrue about what it does.

      If a future change ever needs expedited work, these removals have to come
      out first, or it will fail at run time rather than at build time.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <!-- Explicitly refuse the advertising ID, in case a future dependency asks. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Needed on API 30+ so article links can be handed to a browser.

      Both schemes and BROWSABLE, because the picker enumerates installed
      browsers with a scheme-only `http:` probe and the query has to match for
      them to be visible at all.

      The explicit <package> list is the browsers that will honour a private-tab
      request. It is kept as narrow as it can be: package visibility is itself
      information the app can see about the device, and it should see as little
      as it can. Chromium browsers are absent on purpose — Chromium's
      IntentHandler.isAllowedIncognitoIntent() refuses third-party incognito
      launches, so naming them here would buy nothing but visibility. See
      web/PrivateTabs.kt.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>

        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="us.spotco.fennec_dos" />
        <package android:name="org.mozilla.focus" />
        <package android:name="org.mozilla.klar" />
        <package android:name="org.ironfoxoss.ironfox" />
        <package android:name="org.torproject.torbrowser" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:memtagMode="async"
        android:theme="@style/Theme.Dispatch"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Dispatch.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ArticleActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Dispatch" />

        <!--
          Add a feed. exported=true only for the share filter: sending a link
          from a browser to Dispatch is the most natural way anyone adds a feed,
          and the activity does nothing with the URL except look for a feed at
          it.
        -->
        <activity
            android:name=".ui.AddFeedActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="true"
            android:label="@string/add_feed"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Dispatch"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.StreamEditActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="false"
            android:label="@string/new_stream"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Dispatch"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CategoriesActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="false"
            android:label="@string/categories_title"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Dispatch" />

        <activity
            android:name=".ui.FeedsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="false"
            android:label="@string/feeds_title"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Dispatch" />

        <activity
            android:name=".ui.StreamsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="false"
            android:label="@string/streams_title"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Dispatch" />

        <activity
            android:name=".ui.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Dispatch.Settings" />

        <!--
          The widget's configuration screen, and the target of its gear.
          exported=true because the launcher starts it when a widget is placed;
          it does nothing on its own and reads only the widget id it is handed.
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.Dispatch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NewsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dispatch.reader.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
          BIND_REMOTEVIEWS is a system-only permission: declaring it here means
          nothing but the system can bind this service, which is the whole
          protection a collection widget's factory gets.
        -->
        <service
            android:name=".widget.WidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- See the note on the foreground-service permissions above. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>
</manifest>
