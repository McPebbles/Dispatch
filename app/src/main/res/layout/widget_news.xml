<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4x4 widget.

  Only the view types RemoteViews supports appear here: LinearLayout, TextView,
  ImageView, ImageButton and ListView. Anything else (a ConstraintLayout, a
  RecyclerView, a SwitchCompat) inflates fine in the app and fails silently in
  the launcher's process, which is the classic way a widget comes out blank.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/stream_all"
            android:textColor="@color/widget_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--
          44dp, not 28dp. A widget's buttons are hit through the launcher's
          own gesture handling, which claims a slop of its own before a tap is
          delivered, and a 28dp target at the very edge of the tile loses that
          argument often enough that the gear reads as broken. The icon inside
          is still 20dp; the rest is padding, which costs nothing visually and
          is the entire difference between a button that works and one that
          does not.
        -->
        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_refresh"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh_widget" />

        <ImageButton
            android:id="@+id/widget_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_config_title"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear_widget" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_meta"
        android:textSize="13sp" />
</LinearLayout>
