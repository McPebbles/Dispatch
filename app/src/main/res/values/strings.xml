    <!-- Settings -->
    <string name="settings_title">Settings</string>

    <string name="pref_cat_refresh">Refreshing</string>
    <string name="pref_sync_interval_title">Refresh in the background</string>
    <string name="pref_sync_interval_summary">Dispatch has no push service —
        push on Android means Firebase, which means Google Play services. It
        polls on this schedule instead, using the system\'s own job scheduler.
        Fifteen minutes is the shortest interval Android allows.</string>
    <string name="pref_sync_wifi_title">Only on unmetered networks</string>
    <string name="pref_sync_wifi_summary">Background refreshes wait for Wi-Fi.
        A manual pull-to-refresh always runs.</string>
    <string name="pref_refresh_now_title">Refresh now</string>
    <string name="pref_refresh_now_summary">Fetch every feed once, in the
        background.</string>

    <string name="pref_cat_reading">Reading</string>
    <string name="pref_images_title">Load images</string>
    <string name="pref_images_summary">Thumbnails and article pictures are
        fetched from the publisher\'s servers. Turning this off means the app
        contacts nothing but the feeds themselves.</string>
    <string name="pref_images_off_title">Images turned off</string>
    <string name="pref_images_off_message">Remove the images already stored on
        this device as well?</string>
    <string name="clear_images">Remove them</string>
    <string name="images_cleared">Stored images removed</string>
    <string name="pref_clear_images_title">Clear stored images</string>
    <string name="pref_clear_images_summary">%1$d MB on this device</string>
    <string name="pref_mark_read_title">Mark as read when opened</string>
    <string name="pref_mark_read_summary">Off keeps every story unread until you
        mark it yourself.</string>
    <string name="pref_text_size_title">Text size</string>
    <string name="pref_theme_title">Theme</string>

    <string name="pref_cat_storage">Storage</string>
    <string name="pref_retention_title">Keep stories for</string>
    <string name="pref_retention_summary">Older stories are deleted after each
        refresh. Saved stories are never deleted, and every feed keeps its 50
        newest whatever their age.</string>

    <string name="pref_cat_links">Links</string>
    <string name="pref_link_browser_title">Browser for article links</string>
    <string name="pref_link_browser_summary">Which browser this app hands
        articles to. Separate from the system default on purpose: you can keep
        one browser for everyday use and send a hundred publishers\' links
        somewhere disposable.</string>
    <string name="pref_link_browser_system">System default</string>
    <string name="pref_private_tab_title">Open article links privately</string>
    <string name="pref_private_tab_summary">Only applies when the browser above
        will honour it. Firefox and its forks accept a private-tab request from
        another app; Chromium browsers, including Vanadium, refuse it, and the
        app will say so rather than opening an ordinary tab and calling it
        private. A browser that is always private, like Firefox Focus, never
        asks.</string>

    <string name="pref_cat_about">About</string>
    <string name="pref_version_title">Version</string>
    <string name="pref_version_summary">%1$s (build %2$d)</string>
    <string name="pref_privacy_title">What this app talks to</string>
    <string name="pref_privacy_summary">The feeds you subscribe to, and — when
        images are on — the servers those feeds name for their pictures. Nothing
        else: no analytics, no crash reporting, no Google Play services, and no
        account.</string>

