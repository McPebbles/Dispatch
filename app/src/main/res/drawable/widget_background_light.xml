<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's surface in one fixed appearance. Two drawables rather than one
  with a night qualifier, because WidgetTheme chooses between them: see the
  note in WidgetTheme.kt about the launcher's configuration.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_light_bg" />
    <corners android:radius="18dp" />
</shape>
